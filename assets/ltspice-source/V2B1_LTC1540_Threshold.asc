TEXT -248 944 Left 2 !.param RLOAD=1k\n.param ETA=0.8\n \n.model SW_HYS SW(Ron=1 Roff=1G Vt=3.025 Vh=0.112)\n \n.tran 0 4000 startup\n \n.meas tran T_ON1 WHEN V(EN_AUTO)=1.65 RISE=1\n.meas tran T_OFF1 WHEN V(EN_AUTO)=1.65 FALL=1\n.meas tran T_ON2 WHEN V(EN_AUTO)=1.65 RISE=2\n \n.meas tran V_ON1 FIND V(VSTORE) WHEN V(EN_AUTO)=1.65 RISE=1\n.meas tran V_OFF1 FIND V(VSTORE) WHEN V(EN_AUTO)=1.65 FALL=1\n \n.meas tran ON_TIME1 PARAM T_OFF1-T_ON1\n.meas tran RECHARGE1 PARAM T_ON2-T_OFF1\n.meas tran CYCLE1 PARAM T_ON2-T_ON1
