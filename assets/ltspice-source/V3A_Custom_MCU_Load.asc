TEXT -1304 1024 Left 2 !.meas tran V_STARTUP FIND V(VSTORE) WHEN V(LTCOUT)=1.5 RISE=1\n \n.meas tran T_ON1  WHEN V(LTCOUT)=1.5 RISE=2\n.meas tran T_OFF1 WHEN V(LTCOUT)=1.5 FALL=2\n.meas tran T_ON2  WHEN V(LTCOUT)=1.5 RISE=3\n \n.meas tran V_ON1  FIND V(VSTORE) WHEN V(LTCOUT)=1.5 RISE=2\n.meas tran V_OFF1 FIND V(VSTORE) WHEN V(LTCOUT)=1.5 FALL=2\n \n.meas tran ON_TIME1 PARAM T_OFF1-T_ON1\n.meas tran RECHARGE1 PARAM T_ON2-T_OFF1\n.meas tran CYCLE1 PARAM T_ON2-T_ON1
